  "cards": [
    {
      "dot": "emerald",
      "title": "Configuration",
      "items": [
        "Each flag is set by the Makefile Run B profile",
        "Pinned versions: Fickling 0.1.12, ModelScan 0.8.8, Cosign 3.1.3, OPA 1.21.2",
        "Presidio 2.2.364, Prompt Guard 2 22M, Qdrant 1.19.1, MCP SDK 2.3.0"
