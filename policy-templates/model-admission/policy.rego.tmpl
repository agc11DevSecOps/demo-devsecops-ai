#
# A clean scanner result is detection evidence, never authorization.
package {{PACKAGE}}

# Default deny. An artifact is admitted only when every fact below holds.
default allow := false

# Only non-executable container formats may appear here. A format that can
# execute code, such as pickle, must never be added to this list.
allowed_formats := {{ALLOWED_FORMATS}}

allow if {
	input.artifact.safe_format == true
	input.artifact.format in allowed_formats
	input.artifact.signature_ok == true
	input.artifact.aibom_complete == true
	input.artifact.provenance_ok == true
}
